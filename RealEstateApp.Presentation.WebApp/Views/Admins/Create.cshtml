@model RealEstateApp.Application.ViewModels.Users.RegisterViewModel
@{
    ViewData["Title"] = "Crear Administrador";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Crear Administrador</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserType" value="Administrador" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">Nombre</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Ej. Juan" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">Apellido</label>
                                <input asp-for="LastName" class="form-control" placeholder="Ej. Pérez" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-semibold">Nombre de Usuario</label>
                                <input asp-for="Username" class="form-control" placeholder="juanperez" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">Teléfono (10 dígitos)</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="8091234567" type="tel" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold w-100 py-2">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold w-100 py-2">
                                <i class="bi bi-person-check-fill me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
