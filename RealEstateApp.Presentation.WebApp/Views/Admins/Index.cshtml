@model IList<RealEstateApp.Infrastructure.Identity.Entities.ApplicationUser>
@{
    ViewData["Title"] = "Mantenimiento de Administradores";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2 class="fw-bold text-dark"><i class="bi bi-shield-lock-fill me-2 text-danger"></i>Mantenimiento de Administradores</h2>
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-person-plus-fill me-2"></i>Crear Administrador
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Nombre</th>
                        <th>Nombre de Usuario</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@user.LastName, @user.FirstName</td>
                            <td>@user.UserName</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td class="text-center">
                                @if (user.Id == ViewBag.CurrentUserId)
                                {
                                    <span class="badge bg-success fw-semibold"><i class="bi bi-check-circle me-1"></i>Activo (Tú)</span>
                                }
                                else
                                {
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold">
                                                <i class="bi bi-check-circle me-1"></i>Activo
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-secondary fw-semibold">
                                                <i class="bi bi-dash-circle me-1"></i>Inactivo
                                            </button>
                                        }
                                    </form>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </a>
                                @if (user.Id != ViewBag.CurrentUserId)
                                {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
