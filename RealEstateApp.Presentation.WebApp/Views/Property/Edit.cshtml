@using RealEstateApp.Application.DTOs.Property
@using RealEstateApp.Application.ViewModels.Improvements
@model SavePropertyDto

@{
    ViewData["Title"] = "Editar Propiedad";
    var improvements = ViewBag.Improvements as List<ImprovementViewModel> ?? new();
    var existingImages = ViewBag.ExistingImages as List<string> ?? new();
    var propertyId = (int)(ViewBag.PropertyId ?? 0);
}

<style>
    .form-section { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 24px; }
    .form-section h5 { font-weight: 700; color: #1e3a5f; border-bottom: 2px solid #e9ecef; padding-bottom: 10px; margin-bottom: 20px; }
    .page-header { background: linear-gradient(135deg, #1e3a5f, #f0ad4e); color: white; padding: 35px 0; }
    .existing-img { position: relative; display: inline-block; margin: 5px; }
    .existing-img img { width: 90px; height: 80px; object-fit: cover; border-radius: 8px; }
    .existing-img .remove-btn {
        position: absolute; top: -6px; right: -6px;
        background: #dc3545; color: white; border: none; border-radius: 50%;
        width: 22px; height: 22px; font-size: 0.7rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
</style>

<section class="page-header mb-4">
    <div class="container">
        <h1 class="fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar propiedad</h1>
        <p class="opacity-75 mb-0">Modifica los datos de tu propiedad</p>
    </div>
</section>

<div class="container mb-5">
    <form asp-action="Edit" asp-route-id="@propertyId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="form-section">
            <h5><i class="bi bi-info-circle me-2 text-primary"></i>Datos básicos</h5>
            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label fw-semibold">Título *</label>
                    <input asp-for="Title" class="form-control">
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-semibold">Descripción *</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h5><i class="bi bi-currency-dollar me-2 text-primary"></i>Precio y medidas</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold">Precio (USD) *</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" class="form-control">
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Size" class="form-label fw-semibold">Terreno (m²) *</label>
                    <input asp-for="Size" type="number" step="0.01" class="form-control">
                    <span asp-validation-for="Size" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Rooms" class="form-label fw-semibold">Habitaciones</label>
                    <input asp-for="Rooms" type="number" min="0" max="50" class="form-control">
                </div>
                <div class="col-md-2">
                    <label asp-for="Bathrooms" class="form-label fw-semibold">Baños</label>
                    <input asp-for="Bathrooms" type="number" min="0" max="50" class="form-control">
                </div>
            </div>
        </div>

        <div class="form-section">
            <h5><i class="bi bi-tags me-2 text-primary"></i>Tipo y modalidad</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PropertyTypeId" class="form-label fw-semibold">Tipo de propiedad *</label>
                    <select asp-for="PropertyTypeId" asp-items="ViewBag.PropertyTypes" class="form-select">
                        <option value="">-- Seleccionar --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="SaleTypeId" class="form-label fw-semibold">Tipo de venta *</label>
                    <select asp-for="SaleTypeId" asp-items="ViewBag.SaleTypes" class="form-select">
                        <option value="">-- Seleccionar --</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Imágenes existentes -->
        @if (existingImages.Any())
        {
            <div class="form-section">
                <h5><i class="bi bi-images me-2 text-primary"></i>Imágenes actuales</h5>
                <p class="text-muted small">Haz clic en la X para eliminar una imagen.</p>
                <div id="existingImagesContainer">
                    @for (int i = 0; i < existingImages.Count; i++)
                    {
                        <div class="existing-img" id="img-wrapper-@i">
                            <img src="@existingImages[i]" alt="Imagen @(i+1)">
                            <button type="button" class="remove-btn" onclick="removeImage(@i)">
                                <i class="bi bi-x"></i>
                            </button>
                            <input type="hidden" name="existingImageIds" value="@i" id="existing-id-@i">
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Nuevas imágenes -->
        <div class="form-section">
            <h5><i class="bi bi-cloud-upload me-2 text-primary"></i>Agregar nuevas imágenes</h5>
            <input type="file" name="newImages" class="form-control" multiple accept="image/*">
            <div class="form-text">Puedes agregar hasta 4 imágenes en total entre las existentes y nuevas.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning px-5 fw-semibold">
                <i class="bi bi-save me-2"></i>Guardar cambios
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-lg me-1"></i>Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function removeImage(index) {
            const wrapper = document.getElementById('img-wrapper-' + index);
            const hiddenInput = document.getElementById('existing-id-' + index);
            if (wrapper) wrapper.remove();
            if (hiddenInput) hiddenInput.remove();
        }
    </script>
}
