@using RealEstateApp.Application.DTOs.Property
@using RealEstateApp.Application.ViewModels.Improvements
@model SavePropertyDto

@{
    ViewData["Title"] = "Publicar Propiedad";
    var improvements = ViewBag.Improvements as List<ImprovementViewModel> ?? new();
}

<style>
    .form-section {
        background: white;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        margin-bottom: 24px;
    }

        .form-section h5 {
            font-weight: 700;
            color: #1e3a5f;
            border-bottom: 2px solid #e9ecef;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

    .page-header {
        background: linear-gradient(135deg, #1e3a5f, #0d6efd);
        color: white;
        padding: 35px 0;
    }

    .image-preview-container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .image-preview img {
        width: 80px;
        height: 70px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #dee2e6;
    }

    .improvement-check label {
        cursor: pointer;
    }
</style>

<section class="page-header mb-4">
    <div class="container">
        <h1 class="fw-bold"><i class="bi bi-house-add me-2"></i>Publicar nueva propiedad</h1>
        <p class="opacity-75 mb-0">Completa los datos de tu propiedad para publicarla en el catálogo</p>
    </div>
</section>

<div class="container mb-5">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- Sección: Datos básicos -->
        <div class="form-section">
            <h5><i class="bi bi-info-circle me-2 text-primary"></i>Datos básicos</h5>
            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label fw-semibold">Título de la propiedad *</label>
                    <input asp-for="Title" class="form-control" placeholder="Ej: Hermosa casa con piscina en zona residencial">
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-semibold">Descripción *</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Describe las características principales de la propiedad..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Sección: Precios y medidas -->
        <div class="form-section">
            <h5><i class="bi bi-currency-dollar me-2 text-primary"></i>Precio y medidas</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label fw-semibold">Precio (USD) *</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00">
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Size" class="form-label fw-semibold">Terreno (m²) *</label>
                    <div class="input-group">
                        <input asp-for="Size" type="number" step="0.01" class="form-control" placeholder="0">
                        <span class="input-group-text">m²</span>
                    </div>
                    <span asp-validation-for="Size" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Rooms" class="form-label fw-semibold">Habitaciones</label>
                    <input asp-for="Rooms" type="number" min="0" max="50" class="form-control">
                    <span asp-validation-for="Rooms" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Bathrooms" class="form-label fw-semibold">Baños</label>
                    <input asp-for="Bathrooms" type="number" min="0" max="50" class="form-control">
                    <span asp-validation-for="Bathrooms" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Sección: Categorías -->
        <div class="form-section">
            <h5><i class="bi bi-tags me-2 text-primary"></i>Tipo y modalidad de venta</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PropertyTypeId" class="form-label fw-semibold">Tipo de propiedad *</label>
                    <select asp-for="PropertyTypeId" class="form-select">
                        <option value="">-- Seleccionar tipo --</option>
                        <option value="1">Apartamento</option>
                        <option value="2">Casa</option>
                        <option value="3">Villa</option>
                        <option value="4">Terreno</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SaleTypeId" class="form-label fw-semibold">Tipo de venta *</label>
                    <select asp-for="SaleTypeId" class="form-select">
                        <option value="">-- Seleccionar tipo --</option>
                        <option value="1">Venta</option>
                        <option value="2">Alquiler</option>
                    </select>
                    <span asp-validation-for="SaleTypeId" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Sección: Mejoras -->
        @if (improvements.Any())
        {
            <div class="form-section">
                <h5><i class="bi bi-tools me-2 text-primary"></i>Mejoras</h5>
                <div class="row g-2">
                    @foreach (var imp in improvements)
                    {
                        <div class="col-md-4 improvement-check">
                            <div class="form-check border rounded p-2">
                                <input class="form-check-input" type="checkbox"
                                       name="ImprovementIds" value="@imp.Id" id="imp_@imp.Id">
                                <label class="form-check-label w-100" for="imp_@imp.Id">
                                    <i class="bi bi-check-circle me-1 text-success"></i>@imp.Name
                                    <small class="d-block text-muted">@imp.Description</small>
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        <!-- Sección: Imágenes -->
        <div class="form-section">
            <h5><i class="bi bi-images me-2 text-primary"></i>Imágenes (1 a 4 fotos)</h5>
            <div class="mb-3">
                <input type="file" name="images" id="imageInput" class="form-control"
                       multiple accept="image/*" onchange="handleImageSelection(this)">
                <div class="form-text">Puedes elegir varias fotos a la vez o agregarlas en distintos momentos (máximo 4 en total).</div>
            </div>
            <div class="image-preview-container" id="imagePreview"></div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-5">
                <i class="bi bi-cloud-upload me-2"></i>Publicar propiedad
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-lg me-1"></i>Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Arreglo donde guardamos los archivos
        let selectedFiles = [];

        function handleImageSelection(input) {
            const newFiles = Array.from(input.files);

            // Validar si el acumulado supera el límite de 4 imágenes
            if (selectedFiles.length + newFiles.length > 4) {
                alert('Solo puedes seleccionar un máximo de 4 imágenes en total.');
                input.value = '';
                return;
            }

            // Unir los nuevos archivos al listado actual
            selectedFiles = selectedFiles.concat(newFiles);

            // Sincronizar con el input
            updateInputFiles(input);

            // Renderizar la vista previa
            renderPreviews(input);
        }

        function removeImage(index) {
            // Eliminar elemento seleccionado
            selectedFiles.splice(index, 1);

            const input = document.getElementById('imageInput');
            updateInputFiles(input);
            renderPreviews(input);
        }

        function updateInputFiles(input) {
            // DataTransfer permite asignarle una lista personalizada de archivos al input HTML
            const dt = new DataTransfer();
            selectedFiles.forEach(file => dt.items.add(file));
            input.files = dt.files;
        }

        function renderPreviews(input) {
            const container = document.getElementById('imagePreview');
            container.innerHTML = '';

            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const div = document.createElement('div');
                    div.className = 'image-preview position-relative';
                    div.innerHTML = `
                        <img src="${e.target.result}" alt="Vista previa ${index + 1}">
                        <button type="button"
                                class="btn btn-danger btn-sm position-absolute top-0 end-0 p-0 rounded-circle"
                                style="width: 20px; height: 20px; line-height: 12px; font-size: 0.75rem; transform: translate(30%, -30%);"
                                onclick="removeImage(${index})"
                                title="Eliminar foto">&times;</button>
                        <div class="text-center mt-1" style="font-size:0.7rem; color:#6c757d;">
                            ${index === 0 ? '<span class="badge bg-primary">Principal</span>' : `Foto ${index + 1}`}
                        </div>`;
                    container.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }
    </script>
}
