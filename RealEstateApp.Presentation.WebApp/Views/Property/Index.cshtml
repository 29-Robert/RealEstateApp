@using RealEstateApp.Application.DTOs.Property
@model List<PropertyDto>

@{
    ViewData["Title"] = "Mis Propiedades";
}

<style>
    .page-header { background: linear-gradient(135deg, #1e3a5f, #0d6efd); color: white; padding: 40px 0; }
    .property-row { border-radius: 12px; transition: box-shadow 0.2s; }
    .property-row:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    .thumb { width: 70px; height: 60px; object-fit: cover; border-radius: 8px; }
    .thumb-placeholder { width: 70px; height: 60px; background: #e9ecef; border-radius: 8px; display:flex; align-items:center; justify-content:center; font-size: 1.5rem; color: #adb5bd; }
    .badge-vendida { background: #dc3545; }
    .badge-disponible { background: #198754; }
    .price-col { font-weight: 700; color: #0d6efd; }
</style>

<section class="page-header mb-4">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1"><i class="bi bi-briefcase me-2"></i>Mis Propiedades</h1>
            <p class="opacity-75 mb-0">Gestiona las propiedades que tienes publicadas</p>
        </div>
        <a asp-action="Create" class="btn btn-light fw-semibold">
            <i class="bi bi-plus-circle me-2"></i>Agregar propiedad
        </a>
    </div>
</section>

<div class="container mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-house-add" style="font-size:4rem; color:#dee2e6;"></i>
            <h5 class="text-muted mt-3">No tienes propiedades publicadas aún.</h5>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Publicar mi primera propiedad
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Imagen</th>
                            <th>Propiedad</th>
                            <th>Tipo</th>
                            <th>Precio</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="property-row">
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(p.MainImagePath))
                                    {
                                        <img src="@p.MainImagePath" alt="@p.Title" class="thumb">
                                    }
                                    else
                                    {
                                        <div class="thumb-placeholder"><i class="bi bi-image"></i></div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@p.Title</div>
                                    <small class="text-muted">Cód. @p.Code | @p.Rooms hab. | @p.Bathrooms baños | @p.Size m²</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@p.PropertyTypeName</span><br>
                                    <small class="text-muted">@p.SaleTypeName</small>
                                </td>
                                <td class="price-col">$@p.Price.ToString("N2")</td>
                                <td class="text-center">
                                    @if (p.Status == "Vendida")
                                    {
                                        <span class="badge badge-vendida">Vendida</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-disponible">Disponible</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (p.Status != "Vendida")
                                    {
                                        <a asp-action="Edit" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No editable</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
