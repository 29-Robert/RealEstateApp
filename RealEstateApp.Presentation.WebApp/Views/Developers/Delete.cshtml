@model RealEstateApp.Infrastructure.Identity.Entities.ApplicationUser
@{
    ViewData["Title"] = "Confirmar eliminación de Desarrollador";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 5rem; filter: drop-shadow(0 4px 8px rgba(220,53,69,0.25));"></i>
                    </div>

                    <h3 class="fw-bold text-center text-dark mb-3">¿Eliminar Desarrollador?</h3>
                    <p class="text-muted text-center mb-4">
                        Estás a punto de eliminar la cuenta de desarrollador. Esta acción no se puede deshacer.
                    </p>

                    <div class="bg-light rounded-3 p-4 mb-4 border border-1">
                        <h6 class="fw-bold text-muted text-uppercase mb-3 small"><i class="bi bi-info-circle me-1"></i>Información de cuenta</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Nombre:</span>
                            <span class="fw-semibold text-dark">@Model.FirstName @Model.LastName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-secondary">Usuario:</span>
                            <span class="fw-semibold text-dark">@Model.UserName</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary">Correo:</span>
                            <span class="fw-semibold text-dark">@Model.Email</span>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold w-100 py-2 rounded-2">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger fw-bold w-100 py-2 rounded-2">
                                <i class="bi bi-trash-fill me-1"></i> Confirmar Borrado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
