@model RealEstateApp.Application.ViewModels.Improvements.SaveImprovementViewModel
@{
    ViewData["Title"] = "Eliminar Mejora";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Eliminar Mejora</h4>
                </div>
                <div class="card-body text-center p-4">
                    <h5 class="text-danger mb-3">¿Está seguro que desea eliminar esta mejora?</h5>
                    <p class="text-muted mb-4">
                        Está a punto de eliminar la mejora: <strong class="text-dark">@Model.Name</strong>. Las propiedades asociadas no se eliminarán, únicamente se removerá esta característica de ellas.
                    </p>

                    <form asp-action="DeletePost" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4">Aceptar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>