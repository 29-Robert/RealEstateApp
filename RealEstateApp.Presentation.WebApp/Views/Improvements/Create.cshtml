@model RealEstateApp.Application.ViewModels.Improvements.SaveImprovementViewModel
@{
    ViewData["Title"] = "Crear Mejora";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Crear Mejora</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Nombre de la mejora</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Piscina, Ascensor, Terraza, Planta Eléctrica..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descripción general de la mejora..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-primary">Crear mejora</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>