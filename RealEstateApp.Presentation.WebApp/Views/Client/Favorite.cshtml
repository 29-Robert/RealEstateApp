@model IEnumerable<RealEstateApp.Application.DTOs.Property.PropertyDto>

@{
    ViewData["Title"] = "Mis Favoritos";
}

<div class="container my-4">
    <h2 class="mb-4 text-primary"><i class="bi bi-heart-fill text-danger me-2"></i>Mis Propiedades Favoritas</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-4">
            <h4>No tienes propiedades guardadas en favoritos.</h4>
            <p>Explora el catálogo principal y marca con el corazón las propiedades que te interesen.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Ir al Catálogo</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var property in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <img src="@property.MainImagePath" class="card-img-top" alt="@property.Title" style="height: 200px; object-fit: cover;">

                        <div class="position-absolute top-0 end-0 p-2">
                            <form asp-controller="Client" asp-action="ToggleFavorite" method="post">
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-danger btn-sm shadow">
                                    <i class="bi bi-heart-fill"></i>
                                </button>
                            </form>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title">@property.Title</h5>
                            <p class="text-muted mb-1"><small>Código: @property.Code</small></p>
                            <h4 class="text-success fw-bold">RD$ @property.Price.ToString("N2")</h4>

                            <div class="d-flex justify-content-between text-secondary mt-3">
                                <span><i class="bi bi-door-open"></i> @property.Rooms Hab</span>
                                <span><i class="bi bi-droplet"></i> @property.Bathrooms Baños</span>
                                <span><i class="bi bi-aspect-ratio"></i> @property.Size m²</span>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@property.Id" class="btn btn-outline-primary w-100">
                                Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>