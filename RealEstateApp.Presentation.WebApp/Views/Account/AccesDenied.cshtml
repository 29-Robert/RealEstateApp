@{
    ViewData["Title"] = "Acceso Denegado";

    string returnUrl = Url.Action("Index", "Home") ?? "/";
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        if (User.IsInRole("Cliente"))
        {
            returnUrl = Url.Action("ClientHome", "Home") ?? "/Home/ClientHome";
        }
        else if (User.IsInRole("Agente"))
        {
            returnUrl = Url.Action("Index", "Agent") ?? "/Agent/Index";
        }
        else if (User.IsInRole("Administrador"))
        {
            returnUrl = Url.Action("Index", "Admin") ?? "/Admin/Index";
        }
    }
}

<div class="container my-5">
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-md-7 col-lg-6 text-center">

            @* Icono Visual de Advertencia *@
            <div class="mb-4">
                <i class="bi bi-shield-lock-fill text-danger" style="font-size: 6rem; filter: drop-shadow(0px 4px 10px rgba(220, 53, 69, 0.2));"></i>
            </div>

            @* Mensajes de Error *@
            <h1 class="fw-bold text-dark display-6 mb-3">No tiene permisos para acceder a esta sección.</h1>
            <p class="text-muted fs-5 mb-4">
                Lo sentimos, tu rol actual de usuario no tiene los privilegios requeridos para ver este contenido.
            </p>

            @* Caja informativa de seguridad *@
            <div class="alert alert-warning border-0 shadow-sm rounded-3 p-3 mb-5 text-start d-inline-block w-100">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-3 me-3"></i>
                    <div>
                        <span class="fw-bold d-block text-dark">Área Restringida</span>
                        <small class="text-muted">Si necesitas acceder a esta sección, asegúrate de haber iniciado sesión con las credenciales correspondientes.</small>
                    </div>
                </div>
            </div>

            @* Botones de Acción / Retorno Seguro *@
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a href="@returnUrl" class="btn btn-primary fw-bold px-4 py-2 rounded-2">
                    <i class="bi bi-house-door-fill me-2"></i> Volver al Inicio
                </a>

                <form asp-controller="Account" asp-action="LogOut" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-2 w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión / Cambiar de Cuenta
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>