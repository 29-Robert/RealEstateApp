<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEstateApp.Presentation.WebApp.styles.css" asp-append-version="true" />
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; font-size: 1.3rem; }
        .navbar { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .nav-link { font-weight: 500; transition: color 0.2s; }
        .btn-nav-cta { border-radius: 20px; padding: 6px 20px; font-weight: 600; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container">
                <a class="navbar-brand text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-heart-fill me-2"></i>RealEstateApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @* Menú público (siempre visible) *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-search me-1"></i>Propiedades
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Agent" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Agentes
                            </a>
                        </li>

                        @* Menú exclusivo del Agente *@
                        @if (User.IsInRole("Agente"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="agentMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-briefcase me-1"></i>Mis Propiedades
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="agentMenu">
                                    <li><a class="dropdown-item" asp-controller="Property" asp-action="Index">
                                        <i class="bi bi-list-ul me-2"></i>Ver mis propiedades
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Property" asp-action="Create">
                                        <i class="bi bi-plus-circle me-2"></i>Agregar propiedad
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="AgentProfile" asp-action="Index">
                                        <i class="bi bi-person-circle me-2"></i>Mi Perfil
                                    </a></li>
                                </ul>
                            </li>
                        }

                        @* Menú exclusivo del Administrador *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i>Mantenimiento
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="PropertyTypes" asp-action="Index">
                                        <i class="bi bi-tags me-2"></i>Tipos de Propiedad
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="SaleTypes" asp-action="Index">
                                        <i class="bi bi-currency-dollar me-2"></i>Tipos de Venta
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Improvements" asp-action="Index">
                                        <i class="bi bi-tools me-2"></i>Mejoras
                                    </a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-muted">
                                    <i class="bi bi-person-check me-1"></i>@User.Identity.Name
                                    @if (User.IsInRole("Agente"))
                                    {
                                        <span class="badge bg-success ms-1">Agente</span>
                                    }
                                    else if (User.IsInRole("Administrador"))
                                    {
                                        <span class="badge bg-danger ms-1">Admin</span>
                                    }
                                    else if (User.IsInRole("Cliente"))
                                    {
                                        <span class="badge bg-info ms-1">Cliente</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-nav-cta ms-2" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-nav-cta ms-2" asp-controller="Account" asp-action="Register">
                                    Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-1"><i class="bi bi-house-heart-fill text-primary me-2"></i>RealEstateApp</h5>
                    <small class="text-muted">Tu plataforma de bienes raíces de confianza</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">&copy; 2026 RealEstateApp - Todos los derechos reservados</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
