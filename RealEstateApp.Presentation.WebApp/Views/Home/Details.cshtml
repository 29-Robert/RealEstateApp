@using RealEstateApp.Application.DTOs.Property
@using RealEstateApp.Application.DTOs.Offer
@using RealEstateApp.Domain.Enums
@using System.Security.Claims
@model PropertyDetailDto

@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    bool isOwnProperty = Model.AgentId == currentUserId;
}

<style>
    .detail-hero {
        background: linear-gradient(to bottom, #1e3a5f, #0d6efd);
        color: white;
        padding: 30px 0;
    }
    .carousel-img {
        height: 450px;
        object-fit: cover;
        border-radius: 12px;
    }
    .spec-badge {
        background: #f0f4ff;
        border-radius: 12px;
        padding: 16px 20px;
        text-align: center;
    }
    .spec-badge i { font-size: 1.6rem; color: #0d6efd; }
    .spec-badge .value { font-size: 1.4rem; font-weight: 700; }
    .spec-badge .label { font-size: 0.78rem; color: #6c757d; }
    .improvement-chip {
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border-radius: 20px;
        padding: 6px 16px;
        font-size: 0.85rem;
        font-weight: 500;
        color: #2e7d32;
        display: inline-block;
        margin: 3px;
    }
    .agent-card {
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.10);
        overflow: hidden;
    }
    .agent-photo {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #0d6efd;
    }
    .agent-photo-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        border: 3px solid #0d6efd;
    }
    .price-display {
        font-size: 2.2rem;
        font-weight: 800;
        color: #0d6efd;
    }
    
    /* Estilos del Chat */
    .chat-box {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        background-color: #f8f9fa;
        padding: 15px;
    }
    .chat-message {
        margin-bottom: 15px;
        max-width: 75%;
        padding: 10px 15px;
        border-radius: 15px;
        position: relative;
    }
    .chat-message.client {
        background-color: #0d6efd;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 2px;
    }
    .chat-message.agent {
        background-color: #e9ecef;
        color: #212529;
        margin-right: auto;
        border-bottom-left-radius: 2px;
    }
    .chat-meta {
        font-size: 0.75rem;
        opacity: 0.85;
        margin-top: 5px;
        text-align: right;
    }
    .chat-message.agent .chat-meta {
        color: #6c757d;
        text-align: left;
    }
</style>

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Propiedades</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Columna principal -->
        <div class="col-lg-8">

            <!-- Carrusel de imágenes -->
            @if (Model.ImagePaths != null && Model.ImagePaths.Any())
            {
                <div id="propertyCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        @for (int i = 0; i < Model.ImagePaths.Count; i++)
                        {
                            <button type="button" data-bs-target="#propertyCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"></button>
                        }
                    </div>
                    <div class="carousel-inner rounded-3 shadow">
                        @for (int i = 0; i < Model.ImagePaths.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.ImagePaths[i]" class="carousel-img d-block w-100" alt="Imagen @(i+1)">
                            </div>
                        }
                    </div>
                    @if (Model.ImagePaths.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center mb-4" style="height:350px;">
                    <i class="bi bi-image text-muted" style="font-size:4rem;"></i>
                </div>
            }

            <!-- Título y precio -->
            <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
                <div>
                    <div class="d-flex gap-2 mb-2">
                        <span class="badge bg-primary fs-6">@Model.SaleTypeName</span>
                        <span class="badge bg-success fs-6">@Model.PropertyTypeName</span>
                        <span class="badge bg-secondary fs-6">Cód. @Model.Code</span>
                    </div>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Cliente"))
                        {
                            <div class="d-inline-flex align-items-center gap-3 flex-wrap">
                                <h1 class="h2 fw-bold mb-0">@Model.Title</h1>
                                <form asp-controller="Client" asp-action="ToggleFavorite" method="post" class="d-inline">
                                    <input type="hidden" name="propertyId" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius: 20px;">
                                        @if (Model.IsFavorite)
                                        {
                                            <i class="bi bi-heart-fill me-1 text-danger"></i> @:Quitar de Favoritos
                                        }
                                        else
                                        {
                                            <i class="bi bi-heart me-1"></i> @:Guardar en Favoritos
                                        }
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <h1 class="h2 fw-bold mb-0">@Model.Title</h1>
                        }
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center gap-3 flex-wrap">
                            <h1 class="h2 fw-bold mb-0">@Model.Title</h1>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm" style="border-radius: 20px;">
                                <i class="bi bi-heart me-1"></i> Guardar en Favoritos
                            </a>
                        </div>
                    }
                </div>
                <div class="price-display mt-2">$@Model.Price.ToString("N2")</div>
            </div>

            <!-- Especificaciones -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="spec-badge">
                        <i class="bi bi-door-open d-block mb-2"></i>
                        <div class="value">@Model.Rooms</div>
                        <div class="label">Habitaciones</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="spec-badge">
                        <i class="bi bi-droplet d-block mb-2"></i>
                        <div class="value">@Model.Bathrooms</div>
                        <div class="label">Baños</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="spec-badge">
                        <i class="bi bi-rulers d-block mb-2"></i>
                        <div class="value">@Model.Size</div>
                        <div class="label">m² de terreno</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="spec-badge">
                        <i class="bi bi-check-circle d-block mb-2"></i>
                        <div class="value" style="font-size:1rem;">@Model.Status</div>
                        <div class="label">Estado</div>
                    </div>
                </div>
            </div>

            <!-- Descripción -->
            <div class="mb-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-file-text me-2 text-primary"></i>Descripción</h4>
                <p class="text-muted lh-lg">@Model.Description</p>
            </div>

            <!-- Mejoras -->
            @if (Model.Improvements != null && Model.Improvements.Any())
            {
                <div class="mb-4">
                    <h4 class="fw-bold mb-3"><i class="bi bi-tools me-2 text-primary"></i>Mejoras incluidas</h4>
                    <div>
                        @foreach (var improvement in Model.Improvements)
                        {
                            <span class="improvement-chip">
                                <i class="bi bi-check2 me-1"></i>@improvement
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Chat con el Agente -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Cliente"))
                {
                    <div class="card mt-5 shadow border-0 rounded-3">
                        <div class="card-header bg-dark text-white py-3">
                            <h4 class="mb-0"><i class="bi bi-chat-dots me-2 text-primary"></i>Chat con el Agente</h4>
                        </div>
                        <div class="card-body p-4">
                            @if (TempData["ChatError"] != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ChatError"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            <div class="chat-box mb-4 d-flex flex-column" id="chatContainer" style="max-height: 350px; overflow-y: auto;">
                                @if (Model.ChatMessages != null && Model.ChatMessages.Any())
                                {
                                    @foreach (var msg in Model.ChatMessages)
                                    {
                                        <div class="chat-message @(msg.IsFromClient ? "client" : "agent") shadow-sm">
                                            <div class="fw-bold small mb-1">
                                                @(msg.IsFromClient ? "Tú" : (msg.AgentName ?? "Agente"))
                                            </div>
                                            <p class="mb-0">@msg.Content</p>
                                            <div class="chat-meta mt-1">
                                                @msg.SentAt.ToString("g")
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center text-muted py-5">
                                        <i class="bi bi-chat-text" style="font-size: 3rem;"></i>
                                        <p class="mt-2">No hay mensajes anteriores en esta conversación. ¡Envía un mensaje para comenzar!</p>
                                    </div>
                                }
                            </div>

                            <!-- Formulario de envío -->
                            <form asp-controller="Home" asp-action="SendMessage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PropertyId" value="@Model.Id" />
                                <input type="hidden" name="AgentId" value="@Model.AgentId" />
                                
                                <div class="input-group">
                                    <textarea name="Content" class="form-control" rows="2" placeholder="Escribe tu mensaje aquí..." required maxlength="1000"></textarea>
                                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                                        Enviar <i class="bi bi-send-fill ms-1"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card mt-5 shadow border-0 rounded-3">
                    <div class="card-header bg-dark text-white py-3">
                        <h4 class="mb-0"><i class="bi bi-chat-dots me-2 text-primary"></i>Chat con el Agente</h4>
                    </div>
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-lock-fill text-warning fs-1 mb-3"></i>
                        <h5 class="fw-bold">Chat Protegido</h5>
                        <p class="text-muted small">Inicia sesión como Cliente para guardar en favoritos, chatear con el agente o realizar una oferta económica.</p>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm fw-bold px-4 rounded-3 mt-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar del Agente -->
        <div class="col-lg-4">
            <div class="card agent-card sticky-top" style="top: 80px;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Agente responsable</h5>
                </div>
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(Model.AgentPhotoPath))
                    {
                        <img src="@Model.AgentPhotoPath" alt="Agente" class="agent-photo mb-3">
                    }
                    else
                    {
                        <div class="agent-photo-placeholder mx-auto mb-3">
                            <i class="bi bi-person"></i>
                        </div>
                    }

                    <h5 class="fw-bold mb-1">@Model.AgentFullName</h5>
                    <p class="text-muted small mb-3">Agente de Bienes Raíces</p>

                    @if (!string.IsNullOrEmpty(Model.AgentPhone))
                    {
                        <a href="tel:@Model.AgentPhone" class="btn btn-success w-100 mb-2">
                            <i class="bi bi-telephone me-2"></i>@Model.AgentPhone
                        </a>
                    }

                    <a asp-controller="Agent" asp-action="Properties"
                       asp-route-agentId="@Model.AgentId"
                       class="btn btn-outline-primary w-100 mb-2">
                        <i class="bi bi-houses me-2"></i>Ver más propiedades del agente
                    </a>

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Agente") && isOwnProperty)
                    {
                        <a asp-controller="Agent" asp-action="PropertyDetails" asp-route-id="@Model.Id" class="btn btn-warning w-100 fw-bold">
                            <i class="bi bi-gear-fill me-2"></i>Gestionar propiedad
                        </a>
                    }
                </div>
            </div>

            <!-- Ofertas Económicas -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Cliente"))
                {
                    var clientOffers = ViewBag.ClientOffers as List<OfferDto> ?? new List<OfferDto>();
                    bool disableOfferButton = ViewBag.DisableOfferButton ?? false;
                    bool hasPendingOffer = ViewBag.HasPendingOffer ?? false;
                    bool hasAcceptedOffer = ViewBag.HasAcceptedOffer ?? false;

                    <div class="card shadow border-0 rounded-3 mt-4">
                        <div class="card-header bg-success text-white py-3">
                            <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Ofertas Económicas</h5>
                        </div>
                        <div class="card-body p-4">
                            @if (TempData["OfferError"] != null)
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["OfferError"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }
                            @if (TempData["OfferSuccess"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["OfferSuccess"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            @if (hasAcceptedOffer)
                            {
                                <div class="alert alert-info py-2 mb-3 small">
                                    <i class="bi bi-info-circle me-1"></i> Esta propiedad ya tiene una oferta aceptada.
                                </div>
                            }
                            else if (hasPendingOffer)
                            {
                                <div class="alert alert-warning py-2 mb-3 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Tienes una oferta pendiente.
                                </div>
                            }

                            <!-- Botón para disparar Modal -->
                            <button type="button" class="btn btn-success w-100 fw-bold py-2 rounded-3 mb-4" 
                                    data-bs-toggle="modal" data-bs-target="#newOfferModal"
                                    @(disableOfferButton ? "disabled" : "")>
                                <i class="bi bi-plus-circle me-2"></i>Enviar nueva oferta
                            </button>

                            <!-- Historial de ofertas -->
                            <h6 class="fw-bold mb-3 border-bottom pb-2">Tus Ofertas</h6>
                            @if (clientOffers.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Monto</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var offer in clientOffers)
                                            {
                                                <tr>
                                                    <td>@offer.OfferDate.ToString("dd/MM/yyyy")</td>
                                                    <td class="fw-bold text-success">$@offer.Amount.ToString("N2")</td>
                                                    <td>
                                                        @if (offer.Status == OfferStatus.Pendiente)
                                                        {
                                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                                        }
                                                        else if (offer.Status == OfferStatus.Aceptada)
                                                        {
                                                            <span class="badge bg-success">Aceptada</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Rechazada</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center small my-2">No has realizado ofertas.</p>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="card shadow border-0 rounded-3 mt-4">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Ofertas Económicas</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-lock-fill text-warning fs-1 mb-3"></i>
                        <h5 class="fw-bold">Ofertas Protegidas</h5>
                        <p class="text-muted small">Inicia sesión como Cliente para guardar en favoritos, chatear con el agente o realizar una oferta económica.</p>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-success w-100 fw-bold py-2 rounded-3 mt-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Nueva Oferta -->
@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
{
    <div class="modal fade" id="newOfferModal" tabindex="-1" aria-labelledby="newOfferModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="newOfferModalLabel"><i class="bi bi-cash-coin me-2"></i>Realizar Oferta Económica</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Home" asp-action="SendOffer" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@Model.Id" />
                    
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Monto Ofertado (DOP)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="Amount" class="form-control" placeholder="0.00" step="0.01" min="0.01" required />
                            </div>
                            <small class="text-muted mt-1 d-block">Por favor, escribe un monto decimal mayor que cero.</small>
                        </div>
                    </div>
                    <div class="modal-footer bg-light p-3">
                        <button type="button" class="btn btn-secondary fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success fw-bold">Enviar oferta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var chatContainer = document.getElementById("chatContainer");
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        });
    </script>
}
