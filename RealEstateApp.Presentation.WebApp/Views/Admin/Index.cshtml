@model RealEstateApp.Application.DTOs.Account.AdminDashboardResponseDto
@{
    ViewData["Title"] = "Panel de Control Administrador";
}

<style>
    .admin-header {
        background: linear-gradient(135deg, #111e2e 0%, #1e3a5f 100%);
        color: white;
        padding: 40px 0 25px;
    }
    .kpi-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
    .card-icon {
        font-size: 2.5rem;
        opacity: 0.85;
    }
</style>

<section class="admin-header mb-4">
    <div class="container">
        <h1 class="display-6 fw-bold mb-1">
            <i class="bi bi-speedometer2 me-2 text-warning"></i>Panel de Control
        </h1>
        <p class="lead mb-0 opacity-75">Indicadores generales y estadísticas del sistema</p>
    </div>
</section>

<div class="container mb-5">
    <!-- Primera fila: Inventario de Propiedades -->
    <h4 class="mb-3 fw-bold text-dark border-bottom pb-2">Inventario Comercial</h4>
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card kpi-card bg-success text-white">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="card-subtitle mb-1 text-uppercase opacity-75 fw-semibold">Propiedades Disponibles</h6>
                        <h2 class="card-title display-5 fw-bold mb-0">@Model.AvailableProperties</h2>
                    </div>
                    <i class="bi bi-house-check card-icon"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card kpi-card bg-danger text-white">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="card-subtitle mb-1 text-uppercase opacity-75 fw-semibold">Propiedades Vendidas</h6>
                        <h2 class="card-title display-5 fw-bold mb-0">@Model.SoldProperties</h2>
                    </div>
                    <i class="bi bi-house-dash card-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Segunda fila: Usuarios Activos e Inactivos por Rol -->
    <h4 class="mb-3 fw-bold text-dark border-bottom pb-2">Cuentas de Usuarios</h4>
    <div class="row g-4">
        <!-- Agentes -->
        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card h-100 border-start border-primary border-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-primary fw-bold">Agentes</span>
                        <i class="bi bi-people-fill text-primary fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Activos:</span>
                        <span class="badge bg-success">@Model.AgentesActivos</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Inactivos:</span>
                        <span class="badge bg-secondary">@Model.AgentesInactivos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes -->
        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card h-100 border-start border-info border-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-info fw-bold">Clientes</span>
                        <i class="bi bi-person-fill text-info fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Activos:</span>
                        <span class="badge bg-success">@Model.ClientesActivos</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Inactivos:</span>
                        <span class="badge bg-secondary">@Model.ClientesInactivos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Desarrolladores -->
        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card h-100 border-start border-warning border-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-warning fw-bold">Desarrolladores</span>
                        <i class="bi bi-person-badge-fill text-warning fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Activos:</span>
                        <span class="badge bg-success">@Model.DesarroladoresActivos</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Inactivos:</span>
                        <span class="badge bg-secondary">@Model.DesarroladoresInactivos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Administradores -->
        <div class="col-md-6 col-lg-3">
            <div class="card kpi-card h-100 border-start border-dark border-4">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="text-dark fw-bold">Administradores</span>
                        <i class="bi bi-shield-lock-fill text-dark fs-3"></i>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Activos:</span>
                        <span class="badge bg-success">@Model.AdministradoresActivos</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Inactivos:</span>
                        <span class="badge bg-secondary">@Model.AdministradoresInactivos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
