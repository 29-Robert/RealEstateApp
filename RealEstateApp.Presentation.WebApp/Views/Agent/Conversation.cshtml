@model IEnumerable<RealEstateApp.Application.DTOs.Message.MessageDto>
@{
    ViewData["Title"] = "Chat con el Cliente";

    // Obtenemos los valores de forma segura asegurando el tipo de dato correcto
    int propertyId = ViewBag.PropertyId != null ? Convert.ToInt32(ViewBag.PropertyId) : 0;
    string clientId = ViewBag.ClientId?.ToString() ?? string.Empty;
    var clientName = ViewBag.ClientName as string ?? "Cliente";

    var currentAgentId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Conversación con @clientName</h5>
            <a asp-action="PropertyDetails" asp-route-id="@propertyId" class="btn btn-sm btn-light">
                <i class="bi bi-arrow-left me-1"></i>Volver a la propiedad
            </a>
        </div>

        <!-- Contenedor del historial de mensajes -->
        <div class="card-body chat-box" style="height: 400px; overflow-y: scroll; background-color: #f8f9fa;" id="chatContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var msg in Model)
                {
                    var isClient = msg.IsFromClient;
                    <div class="d-flex mb-3 @(isClient ? "justify-content-start" : "justify-content-end")">
                        <div class="p-3 rounded shadow-sm @(isClient ? "bg-white text-dark border" : "bg-primary text-white")" style="max-width: 75%;">
                            <p class="mb-1">@msg.Content</p>
                            <small class="@(isClient ? "text-muted" : "text-white-50")" style="font-size: 0.75rem;">
                                @msg.SentAt.ToString("dd/MM/yyyy hh:mm tt")
                            </small>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted mt-5">
                    <p>No hay mensajes en esta conversación todavía. ¡Escribe el primero!</p>
                </div>
            }
        </div>

        <!-- Formulario para enviar respuesta -->
        <div class="card-footer bg-white">
            <form asp-action="ReplyMessage" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()

                <!-- Usamos las variables locales que ya validamos arriba -->
                <input type="hidden" name="PropertyId" value="@propertyId" />
                <input type="hidden" name="ClientId" value="@clientId" />

                <input type="text" name="Content" class="form-control" placeholder="Escribe tu respuesta..." autocomplete="off" required />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send me-1"></i>Enviar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chatContainer = document.getElementById("chatContainer");
        chatContainer.scrollTop = chatContainer.scrollHeight;
    </script>
}