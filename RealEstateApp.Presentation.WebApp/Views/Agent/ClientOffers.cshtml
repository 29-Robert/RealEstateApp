@using RealEstateApp.Application.DTOs.Offer
@using RealEstateApp.Application.DTOs.Property
@using RealEstateApp.Domain.Enums
@model List<OfferDto>
@{
    var property = ViewBag.Property as PropertyDetailDto;
    string clientName = ViewBag.ClientName as string ?? "Cliente";
    string clientId = ViewBag.ClientId as string ?? "";
    ViewData["Title"] = $"Ofertas de {clientName}";
    bool isPropertyAvailable = property?.Status == "Disponible";
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Property" asp-action="Index">Mis Propiedades</a></li>
            @if (property != null)
            {
                <li class="breadcrumb-item"><a asp-controller="Agent" asp-action="PropertyDetails" asp-route-id="@property.Id">@property.Title</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Ofertas de @clientName</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2"></i>Ofertas de @clientName</h5>
                        @if (property != null)
                        {
                            <small class="text-white-50">Propiedad: @property.Title (Cód: @property.Code) | Estado: <span class="badge bg-light text-dark fw-bold">@property.Status</span></small>
                        }
                    </div>
                    @if (property != null)
                    {
                        <a asp-controller="Agent" asp-action="PropertyDetails" asp-route-id="@property.Id" class="btn btn-outline-light btn-sm fw-bold">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Detalle
                        </a>
                    }
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Fecha de la Oferta</th>
                                        <th>Monto Ofertado (DOP)</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var offer in Model)
                                    {
                                        <tr>
                                            <td>@offer.OfferDate.ToString("g")</td>
                                            <td class="fw-bold text-success">$@offer.Amount.ToString("N2")</td>
                                            <td>
                                                @if (offer.Status == OfferStatus.Pendiente)
                                                {
                                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                                }
                                                else if (offer.Status == OfferStatus.Aceptada)
                                                {
                                                    <span class="badge bg-success">Aceptada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Rechazada</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (offer.Status == OfferStatus.Pendiente && isPropertyAvailable)
                                                {
                                                    <div class="d-inline-flex gap-2">
                                                        <form asp-controller="Agent" asp-action="AcceptOffer" method="post" onsubmit="return confirm('¿Está seguro de que desea aceptar esta oferta? Se marcará la propiedad como vendida y se rechazarán automáticamente el resto de ofertas pendientes.');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="OfferId" value="@offer.Id" />
                                                            <input type="hidden" name="PropertyId" value="@(property?.Id ?? 0)" />
                                                            <button type="submit" class="btn btn-sm btn-success fw-bold">
                                                                <i class="bi bi-check-lg me-1"></i> Aceptar
                                                            </button>
                                                        </form>

                                                        <form asp-controller="Agent" asp-action="RejectOffer" method="post" onsubmit="return confirm('¿Está seguro de que desea rechazar esta oferta?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="OfferId" value="@offer.Id" />
                                                            <input type="hidden" name="PropertyId" value="@(property?.Id ?? 0)" />
                                                            <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                                                <i class="bi bi-x-lg me-1"></i> Rechazar
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">No disponible</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-cash-coin fs-1"></i>
                            <p class="mt-2">No hay ofertas registradas de este cliente.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
